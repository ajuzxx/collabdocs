                            ]
                        },
                        "description": "Add a user to the workspace with a role (admin/editor/viewer). Returns 409 Conflict if already a member. Concept: Foreign keys, unique constraints, validation, HTTP 409 handling."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                                    "    pm.expect([201, 409]).to.include(pm.response.code);",
                                    "});",
                                    "",
                                    "if (pm.response.code === 201) {",
                                    "    pm.test(\"Response contains membership details\", function () {",
                                    "        var data = pm.response.json();",
                                    "        pm.expect(data).to.have.property(\"id\");",
                                    "        pm.expect(data.role).to.eql(\"editor\");",
                                    "    });",
                                    "} else if (pm.response.code === 409) {",
                                    "    pm.test(\"Duplicate membership rejected with 409 Conflict\", function () {",
                                    "        var data = pm.response.json();",
                                    "        pm.expect(data).to.have.property(\"detail\");",
                                    "    });",
